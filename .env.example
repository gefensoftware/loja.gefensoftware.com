# URL base da API Go (catalog-api-go). Obrigatória em builds de produção —
# sem ela o build falha de propósito, porque publicar a vitrine sem saber
# para onde apontar não serve de nada.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Anúncios (Google AdSense). Vazios = anúncios DESLIGADOS: nenhum script de
# terceiro carrega e /ads.txt responde 404. Antes de ligar, revise a Política
# de Privacidade e adicione o aviso de consentimento — ver README, "Anúncios".
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_VITRINE=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_PRODUTO=0000000000
